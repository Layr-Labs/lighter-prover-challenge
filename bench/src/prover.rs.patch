+// Hash function for transaction data to use as cache key
+fn txs_hash<F: Field + Extend<5> + RichField>(txs: &[Arc<Tx<F>>>) -> u64 {
+    use std::hash::{Hash, Hasher};
+    let mut hasher = DefaultHasher::new();
+    
+    // Hash the length first
+    txs.len().hash(&mut hasher);
+    
+    // Hash each transaction's relevant fields that affect witness generation
+    for tx in txs {
+        // Hash the core transaction data that affects witness computation
+        tx.tx_type.hash(&mut hasher);
+        tx.tx_circuit_type.hash(&mut hasher);
+        tx.tx_index.hash(&mut hasher);
+        tx.nonce.hash(&mut hasher);
+        tx.expired_at.hash(&mut hasher);
+        tx.taker_fee.hash(&mut hasher);
+        tx.maker_fee.hash(&mut hasher);
+        
+        // Hash accounts before (key fields that affect witness)
+        for account in &tx.accounts_before {
+            account.nonce.hash(&mut hasher);
+            account.balance.hash(&mut hasher);
+            account.account_data_root.hash(&mut hasher);
+        }
+        
+        // Hash assets before
+        for asset_account in &tx.account_assets_before {
+            for asset in asset_account {
+                asset.balance.hash(&mut hasher);
+            }
+        }
+    }
+    
+    hasher.finish()
+}
